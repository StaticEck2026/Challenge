; Engine configuration file.
; Godot 4.3+ project: NFL Challenge (1989, XOR Corporation) running on an
; 8086 PC emulator written in GDScript.  No game files are included.

config_version=5

[application]

config/name="NFL Challenge (PC emulator)"
config/description="Runs your own copy of the original NFL.EXE in an 8086/CGA/DOS emulator."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/canvas_textures/default_texture_filter=0
