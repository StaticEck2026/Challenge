; Engine configuration file.
; Godot 4.3+ project: NFL Challenge (1989, XOR Corporation), statically
; recompiled from your own NFL.EXE into GDScript (godot/recomp/, generated by
; tools/recomp/recompile.py, not committed) on a native PC/DOS host layer.
; No game files or game code are included.

config_version=5

[application]

config/name="NFL Challenge (PC emulator)"
config/description="Runs your own copy of the original NFL.EXE, statically recompiled to GDScript, on a native CGA/DOS host layer."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="disabled"

[rendering]

textures/canvas_textures/default_texture_filter=0
